def qute_command(cmd: str) -> None:
    fifo = os.environ.get('QUTE_FIFO')
    if not fifo:
        return
    with open(fifo, 'a', encoding='utf-8') as f:
        f.write(cmd + '\n')


def qute_message(level: str, message: str) -> None:
    qute_command(f'message-{level} {json.dumps(message)}')


def sanitize_filename(name: str) -> str:
    name = re.sub(r'[\x00-\x1f<>:"/\\|?*]+', '', name).strip().rstrip('.')
    name = re.sub(r'\s+', ' ', name)
    return name or 'musescore-score'


def unique_path(path: Path) -> Path:
    if not path.exists():
        return path
    stem, suffix = path.stem, path.suffix
    i = 1
    while True:
        candidate = path.with_name(f'{stem} ({i}){suffix}')
        if not candidate.exists():
            return candidate
        i += 1


def run_console(basedir: str, tab_index: str, js: str) -> str:
    # QUTE_TAB_INDEX is 1-based; qutebrowser-cli @N expects 0-based tab-bar index.
    idx = int(tab_index) - 1
    if idx < 0:
        raise RuntimeError(f'invalid QUTE_TAB_INDEX: {tab_index!r}')

    tab = f'@{idx}'
    proc = subprocess.run(
        [QUTEBROWSER_CLI, 'console', '-b', basedir, tab, js],
        capture_output=True,
        text=True,
        timeout=120,
        check=False,
    )
    if proc.returncode != 0:
        stderr = (proc.stderr or proc.stdout).strip()
        raise RuntimeError(f'qutebrowser console failed: {stderr}')

    out = proc.stdout.strip()
    if not out or out == 'undefined':
        raise RuntimeError('qutebrowser console returned no value; the page script likely threw an exception')
    return out


def ensure_tools() -> None:
    missing = []
    if not (Path(QUTEBROWSER_CLI).is_file() and os.access(QUTEBROWSER_CLI, os.X_OK)):
        missing.append(f'qutebrowser-cli ({QUTEBROWSER_CLI})')
    for tool in ['rsvg-convert', 'convert']:
        if subprocess.run(['bash', '-lc', f'command -v {tool} >/dev/null'], check=False).returncode != 0:
            missing.append(tool)
    if missing:
        raise RuntimeError('missing required tools: ' + ', '.join(missing))


def download_files(urls: Iterable[str], tempdir: Path) -> list[Path]:
    out = []
    for i, url in enumerate(urls):
        ext = '.svg' if '.svg' in url else '.png'
        path = tempdir / f'page_{i:03d}{ext}'
        r = requests.get(url, timeout=90)
        r.raise_for_status()
        path.write_bytes(r.content)
        out.append(path)
    return out


def build_pdf(inputs: list[Path], output: Path) -> None:
    if not inputs:
        raise RuntimeError('no score pages found')
    exts = {p.suffix.lower() for p in inputs}
    if exts == {'.svg'}:
        subprocess.run(['rsvg-convert', '-f', 'pdf', '-o', str(output), *map(str, inputs)], check=True)
        return
    if exts == {'.png'}:
        subprocess.run(['convert', *map(str, inputs), str(output)], check=True)
        return

    with tempfile.TemporaryDirectory() as pdfdir_str:
        pdfdir = Path(pdfdir_str)
        page_pdfs = []
        for i, src in enumerate(inputs):
            page_pdf = pdfdir / f'page_{i:03d}.pdf'
            if src.suffix.lower() == '.svg':
                subprocess.run(['rsvg-convert', '-f', 'pdf', '-o', str(page_pdf), str(src)], check=True)
            else:
                subprocess.run(['convert', str(src), str(page_pdf)], check=True)
            page_pdfs.append(page_pdf)
        subprocess.run(['pdfunite', *map(str, page_pdfs), str(output)], check=True)


def main() -> int:
    try:
        ensure_tools()
        qute_url = os.environ.get('QUTE_URL', '')
        if 'musescore.com/' not in qute_url:
            raise RuntimeError('current tab is not a MuseScore score page')

        basedir = str(Path(os.environ['QUTE_CONFIG_DIR']).resolve().parent)
        tab_index = os.environ['QUTE_TAB_INDEX']
        download_dir = Path(os.environ.get('MUSESCORE_DOWNLOAD_DIR') or (Path.home() / 'Desktop' / 'musescore-sheets'))
        download_dir.mkdir(parents=True, exist_ok=True)

        qute_message('info', 'MuseScore: extracting score pages…')
        info = json.loads(run_console(basedir, tab_index, JS))

        filename = sanitize_filename(info['title']) + '.pdf'
        output = unique_path(download_dir / filename)

        qute_message('info', f"MuseScore: downloading {info['pageCount']} page(s)…")
        with tempfile.TemporaryDirectory() as tempdir_str:
            tempdir = Path(tempdir_str)
            inputs = download_files(info['urls'], tempdir)
            qute_message('info', 'MuseScore: building PDF…')
            build_pdf(inputs, output)

        qute_message('info', f'MuseScore PDF saved to {output}')
        return 0
    except Exception as e:
        qute_message('error', f'MuseScore PDF download failed: {e}')
        return 1


if __name__ == '__main__':
    sys.exit(main())
